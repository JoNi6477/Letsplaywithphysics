<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="author" content="Akshay Kumar"> 
  <meta property="og:site_name" content="Let's Play With Physics">
  <title>Video Courses - Let's Play With Physics</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Space Grotesk', sans-serif; background: #0a0e1a; color: #e8eaf0; overflow-x: hidden; }
    
    nav { display: flex; align-items: center; justify-content: space-between; padding: 18px 40px; background: rgba(10,14,26,0.97); border-bottom: 1px solid rgba(100,180,255,0.12); position: sticky; top: 0; z-index: 100; }
    .nav-logo { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800; color: #fff; text-decoration: none; }
    .nav-logo span { color: #44aaff; }
    .nav-logo img { height: 44px; width: auto; }
    .nav-links { display: flex; gap: 28px; }
    .nav-links a { color: #a0aac0; font-size: 14px; text-decoration: none; transition: color 0.2s; }
    .nav-links a:hover { color: #44aaff; }
    .nav-cta { background: #44aaff; color: #0a0e1a; font-size: 13px; font-weight: 700; padding: 8px 20px; border-radius: 20px; text-decoration: none; }
    .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 4px; background: none; border: none; }
    .hamburger span { display: block; width: 24px; height: 2px; background: #e8eaf0; border-radius: 2px; transition: all 0.3s; }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .mobile-menu { display: none; flex-direction: column; background: rgba(10,14,26,0.99); border-bottom: 1px solid rgba(100,180,255,0.12); max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.3s ease; padding: 0 18px; }
    .mobile-menu.open { max-height: 500px; padding: 16px 18px 20px; }
    .mobile-menu a { color: #a0aac0; font-size: 15px; text-decoration: none; padding: 12px 0; border-bottom: 1px solid rgba(100,180,255,0.07); transition: color 0.2s; display: block; }
    .mobile-menu a:last-child { border-bottom: none; }
    .mobile-menu a:hover { color: #44aaff; }
    .mobile-menu .mob-cta { margin-top: 14px; background: #44aaff; color: #0a0e1a; font-weight: 700; padding: 12px 20px; border-radius: 20px; text-align: center; border-bottom: none !important; }
    
    .hero { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 60px 24px 40px; position: relative; overflow: hidden; }
    .hero-bg { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 80% 60% at 50% 30%, rgba(44,120,255,0.13) 0%, transparent 70%); }
    .hero-orbit { position: absolute; width: 500px; height: 500px; border: 1px dashed rgba(100,180,255,0.1); border-radius: 50%; top: 50%; left: 50%; transform: translate(-50%, -50%); animation: spin 30s linear infinite; }
    .hero-orbit2 { position: absolute; width: 320px; height: 320px; border: 1px dashed rgba(100,180,255,0.08); border-radius: 50%; top: 50%; left: 50%; transform: translate(-50%, -50%); animation: spin 18s linear infinite reverse; }
    @keyframes spin { from { transform: translate(-50%,-50%) rotate(0deg); } to { transform: translate(-50%,-50%) rotate(360deg); } }
    .hero-badge { background: rgba(44,120,255,0.15); border: 1px solid rgba(44,120,255,0.3); color: #7ab8ff; font-size: 12px; font-weight: 500; padding: 6px 16px; border-radius: 20px; margin-bottom: 24px; display: inline-block; position: relative; }
    .hero h1 { font-family: 'Syne', sans-serif; font-size: clamp(36px, 6vw, 60px); font-weight: 800; line-height: 1.1; margin-bottom: 20px; position: relative; }
    .hero h1 .accent { color: #44aaff; }
    .hero h1 .accent2 { color: #f7c948; }
    .hero p { font-size: 17px; color: #8090b0; max-width: 540px; line-height: 1.7; margin-bottom: 36px; position: relative; }
    
    .section { padding: 72px 40px; max-width: 1100px; margin: 0 auto; }
    .section-tag { font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #44aaff; margin-bottom: 12px; }
    .section-title { font-family: 'Syne', sans-serif; font-size: clamp(26px, 4vw, 40px); font-weight: 800; margin-bottom: 14px; }
    .section-sub { font-size: 16px; color: #6070a0; max-width: 500px; line-height: 1.7; margin-bottom: 48px; }
    .divider { border: none; border-top: 1px solid rgba(100,180,255,0.07); margin: 0 40px; }
    
    .courses-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
    .course-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(100,180,255,0.1); border-radius: 18px; overflow: hidden; transition: border-color 0.2s, background 0.2s, transform 0.2s; }
    .course-card:hover { border-color: rgba(100,180,255,0.3); background: rgba(44,120,255,0.08); transform: translateY(-4px); }
    
    .course-header { padding: 32px 28px 20px; border-bottom: 1px solid rgba(100,180,255,0.08); }
    .course-emoji { font-size: 32px; margin-bottom: 12px; display: block; }
    .course-title { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; margin-bottom: 8px; }
    .course-desc { font-size: 14px; color: #6070a0; line-height: 1.6; }
    
    .course-body { padding: 24px 28px; }
    .course-meta { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; }
    .course-videos { background: rgba(44,120,255,0.12); border: 1px solid rgba(44,120,255,0.2); color: #7ab8ff; font-size: 12px; padding: 6px 12px; border-radius: 20px; }
    .course-duration { background: rgba(247,201,72,0.12); border: 1px solid rgba(247,201,72,0.2); color: #f7c948; font-size: 12px; padding: 6px 12px; border-radius: 20px; }
    
    .course-features { list-style: none; margin-bottom: 24px; }
    .course-features li { font-size: 13px; color: #8090b0; display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .course-features li::before { content: '\2713'; font-weight: 700; color: #44aaff; }
    
    .course-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 20px; border-top: 1px solid rgba(100,180,255,0.08); }
    .course-price { font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 800; color: #44aaff; }
    
    .btn-primary { background: #44aaff; color: #0a0e1a; font-weight: 700; padding: 12px 24px; border-radius: 12px; text-decoration: none; font-size: 13px; transition: opacity 0.2s; border: none; cursor: pointer; }
    .btn-primary:hover { opacity: 0.9; }
    
    .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.7); }
    .modal-content { background: #0a0e1a; margin: 5% auto; padding: 40px; border-radius: 20px; width: 90%; max-width: 500px; border: 1px solid rgba(100,180,255,0.2); }
    .close { color: #a0aac0; float: right; font-size: 28px; font-weight: bold; cursor: pointer; transition: color 0.2s; }
    .close:hover { color: #44aaff; }
    .modal h2 { font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 800; margin-bottom: 24px; }
    
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; margin-bottom: 8px; color: #e8eaf0; font-weight: 500; font-size: 14px; }
    .form-group input { width: 100%; padding: 12px 16px; background: rgba(255,255,255,0.05); border: 1px solid rgba(100,180,255,0.15); color: #e8eaf0; border-radius: 12px; font-size: 14px; font-family: inherit; }
    .form-group input::placeholder { color: #3a4a65; }
    .form-group input:focus { outline: none; border-color: rgba(100,180,255,0.4); background: rgba(255,255,255,0.08); }
    
    .course-info { background: rgba(44,120,255,0.08); border: 1px solid rgba(44,120,255,0.2); padding: 16px; border-radius: 12px; margin-bottom: 24px; }
    .course-info strong { display: block; margin-bottom: 4px; color: #e8eaf0; font-weight: 700; }
    .course-info p { color: #6070a0; font-size: 13px; }
    
    .payment-btn { width: 100%; background: #44aaff; color: #0a0e1a; padding: 14px; border: none; border-radius: 12px; font-size: 15px; font-weight: 700; cursor: pointer; margin-top: 8px; transition: opacity 0.2s; }
    .payment-btn:hover { opacity: 0.9; }
    
    footer { border-top: 1px solid rgba(100,180,255,0.07); padding: 28px 40px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .footer-logo { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 15px; color: #fff; }
    .footer-logo span { color: #44aaff; }
    .footer-copy { font-size: 12px; color: #3a4a65; }
    
    @media (max-width: 600px) {
      nav { padding: 14px 18px; }
      .nav-links { display: none; }
      .nav-cta { display: none; }
      .hamburger { display: flex; }
      .mobile-menu { display: flex; }
      .section { padding: 48px 18px; }
      .divider { margin: 0 18px; }
      footer { padding: 20px 18px; }
      .modal-content { padding: 24px 18px; }
      .courses-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <nav>
    <a href="index.html" class="nav-logo">
      <img src="Logo.png" alt="Let's Play With Physics">
    </a>
    <div class="nav-links">
      <a href="index.html#about">About</a>
      <a href="index.html#features">Features</a>
      <a href="index.html#batches">Batches</a>
      <a href="index.html#topics">Syllabus</a>
      <a href="material.html">Materials</a>
      <a href="mocktest.html">Mock Test</a>
      <a href="courses.html" style="color: #44aaff;">Courses</a>
      <a href="index.html#contact">Contact</a>
    </div>
    <a href="index.html#contact" class="nav-cta">Enroll Now</a>
    <button class="hamburger" id="hamburger" onclick="toggleMenu()" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <div class="mobile-menu" id="mobile-menu">
    <a href="index.html#about" onclick="closeMenu()">About</a>
    <a href="index.html#features" onclick="closeMenu()">Features</a>
    <a href="index.html#batches" onclick="closeMenu()">Batches</a>
    <a href="index.html#topics" onclick="closeMenu()">Syllabus</a>
    <a href="material.html" onclick="closeMenu()">Materials</a>
    <a href="mocktest.html" onclick="closeMenu()">Mock Test</a>
    <a href="courses.html" onclick="closeMenu()" style="color: #44aaff;">Courses</a>
    <a href="index.html#contact" onclick="closeMenu()">Contact</a>
    <a href="index.html#contact" class="mob-cta" onclick="closeMenu()">Enroll Now</a>
  </div>

  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-orbit"></div>
    <div class="hero-orbit2"></div>
    <div class="hero-badge">🎓 Video Lectures Now Available!</div>
    <h1>Master Physics<br>with <span class="accent">Complete</span> <span class="accent2">Video</span> Courses</h1>
    <p>Learn from expert-crafted video lectures. Watch at your own pace. Get lifetime access to study materials and download videos.</p>
  </section>

  <hr class="divider">

  <div class="section">
    <div class="section-tag">Video Courses</div>
    <div class="section-title">Choose Your Course</div>
    <div class="section-sub">Complete video lecture series covering all JEE Mains and NEET Physics topics with lifetime access.</div>
    
    <div class="courses-grid" id="coursesGrid">
      <!-- Courses will load here -->
    </div>
  </div>

  <hr class="divider">

  <!-- Payment Modal -->
  <div id="paymentModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeModal()">&times;</span>
      <h2>Complete Your Purchase</h2>
      
      <div class="course-info" id="courseInfo">
        <!-- Course details will appear here -->
      </div>

      <form id="paymentForm">
        <div class="form-group">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" required>
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required>
        </div>

        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone" pattern="[0-9]{10}" placeholder="10-digit mobile number" required>
        </div>

        <button type="button" class="payment-btn" onclick="processPayment()">
          Proceed to Payment
        </button>
      </form>
    </div>
  </div>

  <footer>
    <p class="footer-logo">&copy; 2026 Let's Play With <span>Physics</span></p>
    <p class="footer-copy">
      <a href="index.html#about" style="color: #a0aac0; text-decoration: none;">About</a> &nbsp;|&nbsp;
      <a href="index.html#contact" style="color: #a0aac0; text-decoration: none;">Contact</a> &nbsp;|&nbsp;
      <a href="privacy-policy.html" style="color: #a0aac0; text-decoration: none;">Privacy Policy</a> &nbsp;|&nbsp;
      <a href="terms.html" style="color: #a0aac0; text-decoration: none;">Terms & Conditions</a>
    </p>
  </footer>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    const courses = [
      {
        id: 1,
        title: 'Mechanics Complete',
        emoji: '⚙️',
        description: 'Master Kinematics, Laws of Motion, Work-Energy, and Circular Motion',
        videos: 45,
        duration: '12 weeks',
        price: 499,
        features: ['45 video lectures', '100+ practice problems', 'Chapter notes PDF', 'Lifetime access']
      },
      {
        id: 2,
        title: 'Thermodynamics & Waves',
        emoji: '🌊',
        description: 'Complete coverage of Heat, Thermodynamics, and Wave Motion',
        videos: 35,
        duration: '10 weeks',
        price: 399,
        features: ['35 video lectures', '80+ practice problems', 'Formula sheets', 'Lifetime access']
      },
      {
        id: 3,
        title: 'Electricity & Magnetism',
        emoji: '⚡',
        description: 'Electrostatics, Current, and complete Magnetism coverage',
        videos: 50,
        duration: '14 weeks',
        price: 599,
        features: ['50 video lectures', '120+ practice problems', 'Solution PDFs', 'Lifetime access']
      },
      {
        id: 4,
        title: 'Optics & Modern Physics',
        emoji: '🔬',
        description: 'Geometric & Wave Optics, Quantum Mechanics basics',
        videos: 40,
        duration: '11 weeks',
        price: 499,
        features: ['40 video lectures', '90+ practice problems', 'Quick revision notes', 'Lifetime access']
      },
      {
        id: 5,
        title: 'Complete JEE Physics Bundle',
        emoji: '🎁',
        description: 'All 4 courses combined - SAVE ₹500!',
        videos: 170,
        duration: '47 weeks',
        price: 1499,
        features: ['170 video lectures', '400+ practice problems', 'All materials included', 'Priority support', 'Lifetime access']
      }
    ];

    let selectedCourse = null;

    function loadCourses() {
      const coursesGrid = document.getElementById('coursesGrid');
      coursesGrid.innerHTML = courses.map(course => `
        <div class="course-card">
          <div class="course-header">
            <span class="course-emoji">${course.emoji}</span>
            <h3 class="course-title">${course.title}</h3>
            <p class="course-desc">${course.description}</p>
          </div>
          <div class="course-body">
            <div class="course-meta">
              <span class="course-videos">📺 ${course.videos} Videos</span>
              <span class="course-duration">⏱️ ${course.duration}</span>
            </div>
            <ul class="course-features">
              ${course.features.map(f => `<li>${f}</li>`).join('')}
            </ul>
            <div class="course-footer">
              <span class="course-price">₹${course.price}</span>
              <button class="btn-primary" onclick="openPaymentModal(${course.id})">
                Buy Now
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function openPaymentModal(courseId) {
      selectedCourse = courses.find(c => c.id === courseId);
      document.getElementById('courseInfo').innerHTML = `
        <strong>${selectedCourse.emoji} ${selectedCourse.title}</strong>
        <p>Price: ₹${selectedCourse.price} | ${selectedCourse.videos} videos | ${selectedCourse.duration}</p>
      `;
      document.getElementById('paymentModal').style.display = 'block';
    }

    function closeModal() {
      document.getElementById('paymentModal').style.display = 'none';
    }

    function processPayment() {
      const email = document.getElementById('email').value;
      const phone = document.getElementById('phone').value;
      const name = document.getElementById('name').value;

      if (!email || !phone || !name) {
        alert('Please fill all fields');
        return;
      }

      const options = {
        key: 'YOUR_RAZORPAY_KEY_ID', // Replace with your Razorpay Key ID
        amount: selectedCourse.price * 100,
        currency: 'INR',
        name: 'Let\'s Play With Physics',
        description: selectedCourse.title,
        image: 'Logo.png',
        prefill: {
          name: name,
          email: email,
          contact: phone
        },
        handler: function(response) {
          handlePaymentSuccess(response, selectedCourse, {name, email, phone});
        },
        modal: {
          ondismiss: function() {
            alert('Payment cancelled');
          }
        }
      };

      const rzp = new Razorpay(options);
      rzp.open();
    }

    function handlePaymentSuccess(response, course, userDetails) {
      alert(`✅ Payment Successful!\n\nCourse: ${course.title}\nPayment ID: ${response.razorpay_payment_id}\n\nYou'll receive access details via email shortly.`);
      closeModal();
      document.getElementById('paymentForm').reset();
    }

    window.onclick = function(event) {
      const modal = document.getElementById('paymentModal');
      if (event.target == modal) {
        modal.style.display = 'none';
      }
    }

    function toggleMenu() {
      document.getElementById('mobile-menu').classList.toggle('open');
      document.getElementById('hamburger').classList.toggle('open');
    }

    function closeMenu() {
      document.getElementById('mobile-menu').classList.remove('open');
      document.getElementById('hamburger').classList.remove('open');
    }

    loadCourses();
  </script>

</body>
</html>
